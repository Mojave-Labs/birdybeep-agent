{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot sessionStart",
        "powershell": "birdybeep hook copilot sessionStart",
        "timeoutSec": 15
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot userPromptSubmitted",
        "powershell": "birdybeep hook copilot userPromptSubmitted",
        "timeoutSec": 15
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot preToolUse",
        "powershell": "birdybeep hook copilot preToolUse",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot postToolUse",
        "powershell": "birdybeep hook copilot postToolUse",
        "timeoutSec": 15
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot agentStop",
        "powershell": "birdybeep hook copilot agentStop",
        "timeoutSec": 15
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot subagentStop",
        "powershell": "birdybeep hook copilot subagentStop",
        "timeoutSec": 15
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot errorOccurred",
        "powershell": "birdybeep hook copilot errorOccurred",
        "timeoutSec": 15
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "birdybeep hook copilot sessionEnd",
        "powershell": "birdybeep hook copilot sessionEnd",
        "timeoutSec": 15
      }
    ]
  }
}
