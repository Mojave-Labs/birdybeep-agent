{
  "name": "birdybeep-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Public, MIT-licensed BirdyBeep CLI and adapters for Claude Code, Codex, OpenCode, Cursor, and GitHub Copilot CLI.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:scripts && turbo run test",
    "test:windows": "pnpm test:scripts && turbo run test --concurrency=1",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "release": "node scripts/release.mjs",
    "release:ci": "turbo run build && node scripts/check-pack.mjs && changeset publish",
    "smoke": "node scripts/smoke-test.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-simple-import-sort": "^12",
    "prettier": "^3",
    "tsup": "^8",
    "turbo": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
